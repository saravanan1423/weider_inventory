# Copy this file to .env in the project root.
FLASK_HOST=0.0.0.0
FLASK_PORT=5050
FLASK_DEBUG=false

# MySQL / MariaDB application database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=weider_erp
DB_USER=weider_erp_app
DB_PASSWORD=replace-with-your-database-password
DB_CONNECT_TIMEOUT=10

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173

# Leave blank to derive the proxy from FLASK_PORT
API_PROXY_TARGET=
